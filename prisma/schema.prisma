// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  username     String @unique
  timezone     String

  eventTypes     EventType[]
  availabilities Availability[]
  bookings       Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model EventType {
  id              String @id @default(cuid())
  title           String
  slug            String
  durationMinutes Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Availability {
  id        String @id @default(cuid())
  dayOfWeek Int // 0 = Minggu ... 6 = Sabtu
  startTime Int // menit dari tengah malam, jam LOKAL host (09:00 = 540)
  endTime   Int // menit dari tengah malam, jam LOKAL host (17:00 = 1020)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Booking {
  id            String        @id @default(cuid())
  startTime     DateTime // UTC — instan spesifik
  endTime       DateTime // UTC
  guestName     String
  guestEmail    String
  guestTimezone String
  status        BookingStatus @default(CONFIRMED)

  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, startTime])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}